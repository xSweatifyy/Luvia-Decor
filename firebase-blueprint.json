{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Products catalog for Luvia Decor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "isPriceFrom": { "type": "boolean" },
        "pricePrefix": { "type": "string" },
        "compareAtPrice": { "type": "number" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "imageUrl": { "type": "string" },
        "badge": { "type": "string" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "dimensions": { "type": "string" },
        "materials": { "type": "string" },
        "estimatedDelivery": { "type": "string" }
      },
      "required": ["title", "category", "price", "imageUrl", "inStock"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["orderNumber", "createdAt", "customer", "items", "totalPrice", "status"]
    },
    "site_config": {
      "title": "Site Configuration",
      "description": "Global website settings and content",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "slogan": { "type": "string" },
        "phone": { "type": "string" },
        "supportEmail": { "type": "string" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
