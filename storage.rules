rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product, gallery and branding images must be publicly readable so
    // storefront visitors can see them without signing in.
    match /luvia-decor/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
      allow delete: if true;
    }
  }
}
