{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/coupons/validate", "destination": "/api/coupons?action=validate" },
    { "source": "/api/order-status-email", "destination": "/api/order-status?action=email" },
    { "source": "/api/orders/:id/tracking", "destination": "/api/orders/:id/status?action=tracking" }
  ]
}
